    <sp_widget action="INSERT_OR_UPDATE">
        <category>custom</category>
        <client_script><![CDATA[api.controller = function($scope) {
    /* widget controller */
    var c = this;
    c.applyVariables = function() {
        var g_form = $scope.page.g_form;
        //Console.log('invoke');
        var ga = new GlideAjax('ApplyExcelData');
        ga.addParam('sysparm_name', 'getData');
        ga.addParam('sysparm_attachment_sysid', g_form.getValue('upload_excel_file'));
        //alert('clicked the button!! ' + g_form.getValue('upload_excel_file'));
        ga.getXML(function processResponse(response) {
            var result = response.responseXML.documentElement.getAttribute("answer");
            $scope.page.g_form.clearValue('mrvs_cloud_resource');
            $scope.page.g_form.setValue("mrvs_cloud_resource", result);
        });

    };
};]]></client_script>
